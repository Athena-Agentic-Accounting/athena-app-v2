# =============================================================================
# athena-app-v2 — Environment Variables
# Copy to .env.local and fill in. Never commit .env.local.
# =============================================================================

# ── Backend services (required) ───────────────────────────────────────────────
# athena-engine. Every /api/* call from lib/api/* goes here.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# athena-ai. Used only for the direct agent streams (activity SSE, plan
# approval). getAgentBaseUrl() throws on purpose when this is unset, rather
# than silently falling back and streaming from nowhere.
NEXT_PUBLIC_AGENT_BASE_URL=http://localhost:8000

# ── Clerk (required) ──────────────────────────────────────────────────────────
# Auth + organizations. The app expects an ACTIVE organization: see
# components/auth/require-active-org.tsx. Orgs are provisioned in the Clerk
# dashboard.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
